rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Prescriptions folder: prescriptions/{doctorId}/{patientId}/{filename}
    match /prescriptions/{doctorId}/{patientId}/{allPaths=**} {
      allow read: if request.auth != null && 
        (request.auth.token.role == 'admin' || request.auth.uid == doctorId);
      allow write: if request.auth != null && 
        (request.auth.token.role == 'admin' || request.auth.uid == doctorId)
        && request.resource.size < 15 * 1024 * 1024 // 15MB limit
        && request.resource.contentType.matches('image/.*|application/pdf');
    }
  }
}
